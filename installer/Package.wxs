<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Kotodama" Manufacturer="Akatsukisoft" Version="$(ProductVersion)"
           UpgradeCode="D9BDF128-B0DA-4EA1-AB1D-D813A9EF976D" Scope="perUser">
    <Property Id="ROOTDRIVE" Value="C:\" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Kotodama is already installed." Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />
    <CustomAction Id="StopTray" Directory="BinFolder" ExeCommand="&quot;[BinFolder]Kotodama.Tray.exe&quot; --stop" Execute="immediate" Impersonate="yes" Return="check" />
    <CustomAction Id="ConfigureClients" Directory="BinFolder" ExeCommand="&quot;[BinFolder]Kotodama.exe&quot; configure all" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="UnconfigureClients" Directory="BinFolder" ExeCommand="&quot;[BinFolder]Kotodama.exe&quot; unconfigure all" Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="StopTray" Before="InstallValidate" Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="ConfigureClients" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="UnconfigureClients" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <Feature Id="ProductFeature" Title="Kotodama" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="UserStartup" />
      <ComponentRef Id="KotodamaConfiguration" />
    </Feature>
    <StandardDirectory Id="TARGETDIR">
      <Directory Id="INSTALLFOLDER" Name="Kotodama" ComponentGuidGenerationSeed="02B0CF9F-4C4F-4CF3-B119-5C779D0AAEE0">
        <Directory Id="BinFolder" Name="bin">
          <Component Id="UserStartup" Guid="4C24D1A5-FE93-4D8A-A452-32C7D712DC68">
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Kotodama" Value="&quot;[BinFolder]Kotodama.Tray.exe&quot;" Type="string" KeyPath="yes" />
            <Environment Id="UserPath" Name="PATH" Value="[BinFolder]" Action="set" Part="last" System="no" />
          </Component>
        </Directory>
        <Directory Id="ConfigFolder" Name="config">
          <Component Id="KotodamaConfiguration" Guid="*" Permanent="yes" NeverOverwrite="yes">
            <File Id="KotodamaConfigurationFile" Source="installer\kotodama.json" Name="kotodama.json" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <ComponentGroup Id="ApplicationFiles" Directory="BinFolder">
      <Files Include="$(PublishDir)\**" />
    </ComponentGroup>
  </Package>
</Wix>
